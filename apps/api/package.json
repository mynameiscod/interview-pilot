{
  "name": "@cbi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST + realtime API for CareerPilot Interview",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@cbi/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi:generate": "tsx --conditions=@cbi/source src/openapi/generate.ts",
    "admin:seed": "tsx --env-file-if-exists=../../.env --conditions=@cbi/source src/scripts/seed-super-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@cbi/ai-core": "workspace:*",
    "@cbi/ai-runtime": "workspace:*",
    "@cbi/auth-core": "workspace:*",
    "@cbi/config": "workspace:*",
    "@cbi/db": "workspace:*",
    "@cbi/provider-adapters": "workspace:*",
    "@cbi/shared-types": "workspace:*",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
