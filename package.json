{
  "name": "codebegun-interview",
  "private": true,
  "description": "CareerPilot Interview by CodeBegun — AI interview readiness and assessment platform",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "pnpm --filter @cbi/api openapi:generate",
    "brand:check": "node infrastructure/scripts/brand-check.mjs",
    "smoke:boot": "node infrastructure/scripts/boot-smoke.mjs",
    "infra:up": "docker compose up -d mongo redis mailpit",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0"
  }
}
