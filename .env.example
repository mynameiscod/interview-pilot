# ---------------------------------------------------------------------------
# CareerPilot Interview — environment variables
# Copy to .env for local development. NEVER commit real values.
# Variables marked (Phase N) are not read yet; they are listed so the full
# secret inventory is visible from day one (see docs/architecture §19).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_VERSION=0.0.0-dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=30000

# --- Data stores ------------------------------------------------------------
# Local Docker stack (`pnpm infra:up`) publishes Mongo on 27018 and Redis on 6380
# to avoid clashing with other local installs. Override with CBI_MONGO_HOST_PORT /
# CBI_REDIS_HOST_PORT. directConnection=true is required for the single-node
# replica set when connecting from the host.
MONGODB_URI=mongodb://localhost:27018/cbi_interview?directConnection=true
REDIS_URL=redis://localhost:6380

# --- API --------------------------------------------------------------------
PORT_API=4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# 1 behind the edge NGINX
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=1mb
# refused in production
API_DOCS_ENABLED=true

# --- Worker -----------------------------------------------------------------
WORKER_HEALTH_PORT=4100
WORKER_HEARTBEAT_INTERVAL_MS=15000
# How often live interview timeouts (disconnects, pauses, expiry) are checked.
WORKER_LIVE_SWEEP_INTERVAL_MS=15000
# Parallel evaluation stages (AI scoring and PDF rendering).
WORKER_EVALUATION_CONCURRENCY=3
# The worker reads the same EMAIL_* / SMTP_* settings below to send "report ready"
# emails, and PUBLIC_CANDIDATE_URL for the link. Set EMAIL_PROVIDER=disabled to skip them.
# Parallel jobs per worker process (document parsing is CPU- and memory-heavy).
WORKER_DOCUMENT_CONCURRENCY=2
WORKER_ANALYSIS_CONCURRENCY=4
# Job-description URL fetching (SSRF-guarded: public addresses only, bounded size and time).
JD_FETCH_TIMEOUT_MS=10000
JD_FETCH_MAX_BYTES=2097152

# --- Web apps (public, embedded in the JS bundle — no secrets) --------------
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=development

# --- Public URLs (used in emails) -------------------------------------------
PUBLIC_CANDIDATE_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174

# --- Sessions ---------------------------------------------------------------
# DEVELOPMENT VALUES ONLY. Generate real secrets with: openssl rand -base64 48
# Values containing "dev-only" or "change-me" are refused in staging/production.
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SEC=600
REFRESH_TTL_CANDIDATE_DAYS=30
REFRESH_TTL_ADMIN_HOURS=12
# Leave empty to scope the refresh cookie to the API host (recommended).
COOKIE_DOMAIN=

# --- OTP --------------------------------------------------------------------
# Must differ from JWT_ACCESS_SECRET.
OTP_HMAC_SECRET=dev-only-otp-secret-change-me-0123456789abcdef
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_PER_DESTINATION_PER_HOUR=5

# --- Google sign-in ---------------------------------------------------------
# OAuth 2.0 *Web* client id from Google Cloud Console (no client secret needed:
# the apps use Google Identity Services ID tokens). Empty disables Google.
# Add http://localhost:5173 and http://localhost:5174 as authorized JavaScript origins.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Email ------------------------------------------------------------------
# ses | smtp. Local development uses the Mailpit inbox at http://localhost:8025.
EMAIL_PROVIDER=smtp
EMAIL_FROM=CareerPilot Interview <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit has no TLS; production SMTP must use TLS (enforced).
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
# Production (AWS SES):
# EMAIL_PROVIDER=ses
# SES_REGION=ap-south-1
# Omit both keys to use the default AWS credential chain.
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=

# --- SMS OTP ----------------------------------------------------------------
# msg91 | dev-mailbox | disabled
# dev-mailbox delivers SMS codes into the Mailpit inbox (local development only).
SMS_PROVIDER=dev-mailbox
# Production (MSG91; requires a DLT-approved Flow template):
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# Name of the template variable that receives the code.
# MSG91_OTP_VARIABLE=otp

# --- Admin bootstrap --------------------------------------------------------
# pnpm --filter @cbi/api admin:seed --email you@codebegun.com
# SEED_SUPER_ADMIN_EMAIL=

# --- AI providers (Phase 2) -------------------------------------------------
# Provider API keys are entered in Admin and stored encrypted (AES-256-GCM) with
# this key. DEVELOPMENT VALUE ONLY (refused in staging/production).
# Generate a real key with: openssl rand -base64 32
AI_SECRETS_MASTER_KEY=ZGV2LW9ubHktYWktbWFzdGVyLWtleS1jaGFuZ2UtbWU=
AI_SECRETS_KEY_ID=k1
# Rotation: set a new key + id above and keep old ones here (keyId:base64,...).
# Stored credentials are re-encrypted with the current key at API start.
AI_SECRETS_PREVIOUS_KEYS=
# Deterministic, labelled mock provider so AI features work without keys.
# development/test only (refused in staging/production).
AI_MOCK_MODE=true
# How long each API process caches AI routing config (admin changes also bust it via Redis).
AI_CONFIG_CACHE_TTL_SEC=30
# Optional first-run keys, imported once (encrypted) when a provider has no key yet.
# AI_BOOTSTRAP_OPENAI_API_KEY=
# AI_BOOTSTRAP_ANTHROPIC_API_KEY=
# AI_BOOTSTRAP_GEMINI_API_KEY=
# --- Object storage (Phase 3 / 8) -------------------------------------------
# Uploaded resumes and JDs. The API and the worker must use the same storage.
# `local` writes to LOCAL_STORAGE_DIR (development only; refused in staging/production).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
# STORAGE_PROVIDER=bunny
# BUNNY_STORAGE_ZONE=
# Region endpoint: storage.bunnycdn.com (Falkenstein), sg.storage.bunnycdn.com, ...
# BUNNY_STORAGE_REGION_HOST=storage.bunnycdn.com
# BUNNY_STORAGE_ACCESS_KEY=
# BUNNY_PULLZONE_HOST=
# BUNNY_PULLZONE_TOKEN_KEY=
UPLOAD_MAX_MB=8
# Days a video recording is kept before it is deleted automatically (Phase 8).
MEDIA_RETENTION_DAYS_DEFAULT=90
# Worker: how often abandoned recordings are closed and expired ones deleted.
WORKER_MEDIA_SWEEP_INTERVAL_MS=900000
# --- Payments (Phase 6) ------------------------------------------------------
# `mock` (development/test only; refused in staging/production) completes Checkout
# in-app with "simulate payment" buttons. Use `razorpay` with test keys to try the
# real Checkout. The key id is returned with each order, so the web apps need no key.
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# Webhook URL: <api>/api/v1/payments/webhooks/razorpay (payment.captured, order.paid,
# payment.failed, refund.processed, refund.failed). Payments must be auto-captured.
# RAZORPAY_WEBHOOK_SECRET=
# Worker: how often unconfirmed purchases and pending refunds are reconciled.
WORKER_PAYMENT_RECONCILE_INTERVAL_MS=3600000
# MEDIA_RETENTION_DAYS_DEFAULT=90

# --- Razorpay (Phase 6) -----------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Code judge (Phase 9; interim Judge0 on a separate host) ----------------
# judge0 | codebegun | mock
# JUDGE_PROVIDER=judge0
# JUDGE_BASE_URL=
# JUDGE_HMAC_SECRET=

# --- Backups (Phase 12) -----------------------------------------------------
# BUNNY_BACKUP_ZONE=
# BUNNY_BACKUP_ACCESS_KEY=
# BACKUP_AGE_PUBLIC_KEY=

# --- Feature flags ----------------------------------------------------------
# FEATURE_PUBLIC_PROOF_SHARING=false
