# ---------------------------------------------------------------------------
# CareerPilot Interview — environment variables
# Copy to .env for local development. NEVER commit real values.
# Variables marked (Phase N) are not read yet; they are listed so the full
# secret inventory is visible from day one (see docs/architecture §19).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_VERSION=0.0.0-dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=30000

# --- Data stores ------------------------------------------------------------
# Local Docker stack (`pnpm infra:up`) publishes Mongo on 27018 and Redis on 6380
# to avoid clashing with other local installs. Override with CBI_MONGO_HOST_PORT /
# CBI_REDIS_HOST_PORT. directConnection=true is required for the single-node
# replica set when connecting from the host.
MONGODB_URI=mongodb://localhost:27018/cbi_interview?directConnection=true
REDIS_URL=redis://localhost:6380

# --- API --------------------------------------------------------------------
PORT_API=4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# 1 behind the edge NGINX
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=1mb
# refused in production
API_DOCS_ENABLED=true

# --- Worker -----------------------------------------------------------------
WORKER_HEALTH_PORT=4100
WORKER_HEARTBEAT_INTERVAL_MS=15000

# --- Web apps (public, embedded in the JS bundle — no secrets) --------------
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=development

# --- Auth (Phase 1) ---------------------------------------------------------
# JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL=10m
# REFRESH_TTL_CANDIDATE=30d
# REFRESH_TTL_ADMIN=12h
# COOKIE_DOMAIN=
# OTP_HMAC_SECRET=
# OTP_TTL_SEC=300
# OTP_MAX_ATTEMPTS=5
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SEED_SUPER_ADMIN_EMAIL=

# --- Email: AWS SES (Phase 1) -----------------------------------------------
# ses | mock (mock refused in staging/production)
# EMAIL_PROVIDER=ses
# SES_REGION=ap-south-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# EMAIL_FROM=

# --- SMS OTP: MSG91 (Phase 1; requires DLT registration) --------------------
# msg91 | mock
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=

# --- AI providers (Phase 2) -------------------------------------------------
# Provider API keys are entered in Admin and stored encrypted with this key.
# base64, 32 bytes
# AI_SECRETS_MASTER_KEY=
# AI_SECRETS_KEY_ID=k1
# development/test only
# AI_MOCK_MODE=false

# --- Bunny Storage (Phase 3 / 8) --------------------------------------------
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_REGION_HOST=
# BUNNY_STORAGE_ACCESS_KEY=
# BUNNY_PULLZONE_HOST=
# BUNNY_PULLZONE_TOKEN_KEY=
# UPLOAD_MAX_MB=8
# MEDIA_RETENTION_DAYS_DEFAULT=90

# --- Razorpay (Phase 6) -----------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Code judge (Phase 9; interim Judge0 on a separate host) ----------------
# judge0 | codebegun | mock
# JUDGE_PROVIDER=judge0
# JUDGE_BASE_URL=
# JUDGE_HMAC_SECRET=

# --- Backups (Phase 12) -----------------------------------------------------
# BUNNY_BACKUP_ZONE=
# BUNNY_BACKUP_ACCESS_KEY=
# BACKUP_AGE_PUBLIC_KEY=

# --- Feature flags ----------------------------------------------------------
# FEATURE_PUBLIC_PROOF_SHARING=false
