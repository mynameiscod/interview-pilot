{
  "name": "@cbi/pdf-fonts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embedded Noto / Hind Guntur fonts and helpers for writing English, Hindi and Telugu in pdfkit documents",
  "exports": {
    ".": {
      "@cbi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pdfkit": "0.17.6",
    "pdfkit": "0.20.2",
    "vitest": "5.0.1"
  }
}
