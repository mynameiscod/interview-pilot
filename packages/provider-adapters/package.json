{
  "name": "@cbi/provider-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapters for external providers: email, SMS and LLMs (OpenAI, Anthropic, Gemini, mock); storage, payments and judge in later phases",
  "exports": {
    ".": {
      "@cbi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "@cbi/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@aws-sdk/client-sesv2": "3.1138.0",
    "@cbi/ai-core": "workspace:*",
    "@cbi/shared-types": "workspace:*",
    "@google/genai": "2.24.0",
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "nodemailer": "10.0.10",
    "openai": "7.23.0",
    "undici": "8.11.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "vitest": "5.0.1"
  }
}
