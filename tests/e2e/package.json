    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit",
    "e2e:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint specs support playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "24.13.6"
  }
}
