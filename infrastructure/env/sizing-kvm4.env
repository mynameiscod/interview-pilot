# Resource sizing for a Hostinger KVM 4 (4 vCPU / 16 GB). Copy to ${CBI_HOME}/sizing.env
# (e.g. /srv/cbi/sizing.env); deploy.sh merges it into compose.env on every deploy.
# The compose file's defaults fit a KVM 8 (8 vCPU / 32 GB).
#
# Steady state ≈ 11.8 GB of limits (API 2.5 + worker 2 + Mongo 5 + Redis 1.5 + NGINX 0.5
# + certbot 0.25); during a deploy the idle API colour adds 2.5 GB for about a minute.
# Plain KEY=value lines only (read by infrastructure/scripts/lib/common.sh).

API_CPUS=2
API_MEM=2560m
API_MEM_RESERVED=512m

WORKER_REPLICAS=1
WORKER_CPUS=1.5
WORKER_MEM=2g
WORKER_MEM_RESERVED=512m

MONGO_CPUS=2
MONGO_MEM=5g
MONGO_MEM_RESERVED=2g
MONGO_WT_CACHE_GB=2

REDIS_CPUS=1
REDIS_MEM=1536m
REDIS_MAXMEMORY=1gb

NGINX_CPUS=1
NGINX_MEM=512m
