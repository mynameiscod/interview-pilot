# ---------------------------------------------------------------------------
# Backup settings for infrastructure/scripts/backup.sh and restore*.sh.
# Copy to /srv/cbi/.env.backup (owner root, mode 600). Placeholders only.
# ---------------------------------------------------------------------------

# Where encrypted archives go:
#   bunny          Bunny Storage HTTP API (a SEPARATE zone from app uploads)
#   local:<dir>    a local directory (testing / restore drills / extra copy)
BACKUP_TARGET=bunny
BUNNY_BACKUP_ZONE=REPLACE_WITH_BACKUP_STORAGE_ZONE
# Region endpoint of the backup zone (pick a different region from the app zone).
BUNNY_BACKUP_REGION_HOST=storage.bunnycdn.com
# The backup zone's password (Storage → FTP & API access). Not the account API key.
BUNNY_BACKUP_ACCESS_KEY=REPLACE_WITH_BACKUP_ZONE_PASSWORD
# Path prefix inside the zone (one per environment).
BUNNY_BACKUP_PREFIX=production

# age public key(s), one per line, in this file. Keep the matching identity
# (private key) OFF the server: password manager + offline copy.
BACKUP_AGE_RECIPIENTS_FILE=/srv/cbi/backup/age-recipients.txt

# Retention (prune remote): daily archives kept, weekly (Sunday) archives kept.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Restore drill only (restore-drill.sh) ---------------------------------------
# Path to the age identity (private key). Only on the host that runs the drill
# (recommended: NOT the production VPS). Empty on hosts that only take backups.
BACKUP_AGE_IDENTITY_FILE=
# The backup zone's READ-ONLY password, used by the drill to download.
BUNNY_BACKUP_READONLY_KEY=
# Fail the drill when the newest backup is older than this.
BACKUP_MAX_AGE_HOURS=30

# Optional: a URL that receives a POST on failure (e.g. a healthchecks.io ping
# URL ending in /fail, or an alerting webhook). Empty = log only.
BACKUP_ALERT_URL=
