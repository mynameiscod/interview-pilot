# ---------------------------------------------------------------------------
# CareerPilot Interview — API + worker runtime environment (staging / production)
#
# Copy to /srv/cbi/.env.production (or /srv/cbi/.env.staging), owner root, mode 600:
#   sudo install -m 600 -o root -g root production.env.example /srv/cbi/.env.production
# Every value below is a PLACEHOLDER. Never commit real values.
# Validated at start-up by packages/config/src/env.ts: staging/production refuse
# the development secrets, mock AI/payment/judge providers, local storage,
# dev-mailbox SMS, non-HTTPS CORS origins and (production) API docs.
#
# Set by docker-compose.production.yml, do NOT set here:
#   PORT_API=4000, TRUST_PROXY_HOPS=1, SHUTDOWN_GRACE_MS (60 s api / 120 s worker),
#   WORKER_HEALTH_PORT=4100. APP_VERSION is baked into each image at build time
#   (the release tag; /healthz reports it). LOCAL_STORAGE_DIR is development-only.
# ---------------------------------------------------------------------------

# --- Core (api + worker) -----------------------------------------------------
# staging | production
APP_ENV=production
LOG_LEVEL=info

# --- Data stores (api + worker) ------------------------------------------------
# Users are created by infrastructure/mongo/init-replica-set.js from .env.datastores;
# the user, password and database here MUST match MONGO_APP_USER / MONGO_APP_PASSWORD /
# MONGO_APP_DB there. URL-encode special characters in passwords (or use hex passwords:
# openssl rand -hex 32).
MONGODB_URI=mongodb://cbi_app:REPLACE_WITH_MONGO_APP_PASSWORD@mongo:27017/cbi_interview?replicaSet=rs0&authSource=cbi_interview
# Connections per process (each live turn runs a short transaction). One API colour +
# 2 workers x 100 stays far below mongod's limit.
MONGODB_MAX_POOL_SIZE=100
# Must match REDIS_PASSWORD in .env.datastores.
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
# redis-ha compose profile only: follow the master through the sentinels (REDIS_URL then
# supplies just the password). Leave empty without the profile.
REDIS_SENTINELS=
# REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_MASTER=cbi
# mongo-psa / mongo-3node profiles: list every member in MONGODB_URI, e.g.
#   mongodb://cbi_app:...@mongo:27017,mongo-2:27017,mongo-3:27017/cbi_interview?replicaSet=rs0&authSource=cbi_interview

# --- Public URLs (api; worker uses PUBLIC_CANDIDATE_URL for email links) --------
# Staging: https://interview-staging.codebegun.com, https://admin.interview-staging.codebegun.com
PUBLIC_CANDIDATE_URL=https://interview.codebegun.com
PUBLIC_ADMIN_URL=https://admin.interview.codebegun.com
# HTTPS origins only (enforced). Both web apps call the API cross-origin.
CORS_ALLOWED_ORIGINS=https://interview.codebegun.com,https://admin.interview.codebegun.com
REQUEST_BODY_LIMIT=1mb
# Refused in production. May be true on staging.
API_DOCS_ENABLED=false

# --- Sessions (api) --------------------------------------------------------------
# openssl rand -base64 48  — at least 32 chars; must differ from OTP_HMAC_SECRET.
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
JWT_ACCESS_TTL_SEC=600
REFRESH_TTL_CANDIDATE_DAYS=30
REFRESH_TTL_ADMIN_HOURS=12

# Absolute session lifetime from sign-in (refreshing never extends past it).
SESSION_MAX_AGE_CANDIDATE_DAYS=90
SESSION_MAX_AGE_ADMIN_DAYS=7
# Admin two-factor (authenticator app): super_admin (default) or all.
ADMIN_MFA_REQUIRED=super_admin
ADMIN_MFA_ISSUER=CareerPilot Interview Admin

# --- Data rights and legal pages (DPDP Act 2023) ------------------------------
# Days between an account deletion request and erasure (sign-in within it cancels).
ACCOUNT_DELETION_GRACE_DAYS=7
# Job descriptions / resumes one candidate may add per rolling 24 hours.
INPUT_DAILY_LIMIT_JOBS=40
INPUT_DAILY_LIMIT_RESUMES=20
RESUME_TAILOR_DAILY_LIMIT=10
# Grievance Officer shown on the legal pages (never hard-coded). Leave empty until appointed.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_ADDRESS=
# true shows "Draft — pending legal review" on the legal pages; set false after sign-off.
LEGAL_DRAFT_BANNER=true
# Shown as "Last updated" (YYYY-MM-DD); empty hides it.
LEGAL_LAST_UPDATED=
# Empty = refresh cookie scoped to the API host (recommended).
COOKIE_DOMAIN=

# --- OTP (api) --------------------------------------------------------------------
# openssl rand -base64 48 — also keys pseudonymous IP/destination hashes.
OTP_HMAC_SECRET=REPLACE_WITH_ANOTHER_OPENSSL_RAND_BASE64_48
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_PER_DESTINATION_PER_HOUR=5

# --- Google sign-in (api) — empty disables it ------------------------------------
# OAuth *Web* client id; authorized JavaScript origins = the two site URLs above.
# The web images are built with the same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Integrations: email, SMS, storage, payments, code judge ------------------------
# Recommended: leave these as they are and set each provider up in the admin site
# (System → Integrations, SUPER_ADMIN). Credentials entered there are encrypted with
# AI_SECRETS_MASTER_KEY, applied without a restart, and take precedence over this file.
# Until an integration is set up, its features answer "not set up yet" (503).
#
# Alternatively, configure a provider here (commented examples below); an admin
# configuration still overrides it.

# Email (api: sign-in codes; worker: report-ready emails): ses | smtp | disabled
EMAIL_PROVIDER=disabled
EMAIL_FROM=CareerPilot Interview <no-reply@interview.codebegun.com>
# EMAIL_PROVIDER=ses
# SES_REGION=ap-south-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# EMAIL_PROVIDER=smtp            (TLS is mandatory in staging/production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASS=

# SMS OTP (api): msg91 | disabled   (dev-mailbox is refused)
SMS_PROVIDER=disabled
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp

# --- AI (api + worker) --------------------------------------------------------------
# Encrypts provider API keys stored through Admin (AES-256-GCM): openssl rand -base64 32
AI_SECRETS_MASTER_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
AI_SECRETS_KEY_ID=k1
# During rotation only: previous keys as keyId:base64,... (runbook-key-rotation.md)
AI_SECRETS_PREVIOUS_KEYS=
# Refused in staging/production.
AI_MOCK_MODE=false
AI_CONFIG_CACHE_TTL_SEC=30
# Optional first-run keys, imported once (encrypted) when a provider has no key.
# Prefer entering keys in Admin → AI providers, then delete these lines.
AI_BOOTSTRAP_OPENAI_API_KEY=
AI_BOOTSTRAP_ANTHROPIC_API_KEY=
AI_BOOTSTRAP_GEMINI_API_KEY=

# Object storage (api + worker): bunny | none   (`local` is refused)
STORAGE_PROVIDER=none
# STORAGE_PROVIDER=bunny
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_REGION_HOST=sg.storage.bunnycdn.com
# BUNNY_STORAGE_ACCESS_KEY=
# Resume/JD upload limit (MB). NGINX allows 12 MB bodies on upload routes; keep <= 10.
UPLOAD_MAX_MB=8
MEDIA_RETENTION_DAYS_DEFAULT=90

# Payments (api + worker): razorpay | none   (`mock` is refused)
# Razorpay webhook URL: https://api.interview.codebegun.com/api/v1/payments/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
PAYMENT_PROVIDER=none
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Code judge (api + worker): codebegun | judge0 | none   (`mock` is refused). The judge
# runs on a separate host, never this VPS. Without one, coding rounds record code without
# running it (as when the judge is down).
JUDGE_PROVIDER=none
# JUDGE_PROVIDER=judge0
# JUDGE_BASE_URL=https://judge.internal.example
# JUDGE_HMAC_SECRET=              (at least 32 characters, shared with the judge's proxy)
# JUDGE0_AUTH_TOKEN=
# JUDGE0_MAX_BATCH_SIZE=20        (match Judge0's MAX_SUBMISSION_BATCH_SIZE)

# --- Audit log (api) -----------------------------------------------------------------
# Days audit entries are kept before MongoDB's TTL index deletes them (30-3650; default
# 730 = two years). Applied to the index at API start; lowering it deletes older entries.
AUDIT_LOG_RETENTION_DAYS=730

# --- Observability (api + worker; docs/deployment/observability.md) ------------------
# Sentry or GlitchTip DSN; empty disables error tracking. Its https origin is also added
# to the SPAs' CSP connect-src by deploy.sh (browser DSN is the VITE_SENTRY_DSN build
# variable in GitHub). SENTRY_RELEASE is baked into the image (git sha); do not set it here.
SENTRY_DSN=
# Defaults to APP_ENV.
SENTRY_ENVIRONMENT=
# Extra CSP connect-src origins, space-separated (e.g. a browser DSN on another host).
# Overrides the SENTRY_DSN-derived origin. Read by deploy.sh only.
CSP_CONNECT_SRC_EXTRA=
# Prometheus /metrics (API :4000, worker :4100) on the Docker network only; NGINX
# returns 404 publicly. A bearer token is recommended: openssl rand -hex 24
METRICS_ENABLED=true
METRICS_TOKEN=

# --- Worker tuning -------------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_PROVIDER_HEALTH_INTERVAL_MS=60000
WORKER_LIVE_SWEEP_INTERVAL_MS=15000
WORKER_PAYMENT_RECONCILE_INTERVAL_MS=3600000
WORKER_MEDIA_SWEEP_INTERVAL_MS=900000
# Joined, seekable recordings; the worker image installs ffmpeg.
WORKER_MEDIA_FILE_INTERVAL_MS=60000
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFMPEG_TIMEOUT_MS=1200000

# How often accounts past their deletion grace period are erased.
WORKER_ACCOUNT_ERASURE_INTERVAL_MS=3600000
WORKER_PRACTICE_NUDGE_INTERVAL_MS=21600000
WORKER_ANALYTICS_ROLLUP_INTERVAL_MS=900000
WORKER_EVALUATION_CONCURRENCY=3
WORKER_DOCUMENT_CONCURRENCY=2
WORKER_ANALYSIS_CONCURRENCY=4
JD_FETCH_TIMEOUT_MS=10000
JD_FETCH_MAX_BYTES=2097152
# Scanned-PDF OCR through the ocr.document AI route (page and size caps).
OCR_ENABLED=true
OCR_MAX_PAGES=10
OCR_MAX_MB=8
# Campaign package exports (EXPORT_SPOOL_DIR is set by docker-compose.production.yml).
WORKER_EXPORT_CONCURRENCY=1
CAMPAIGN_EXPORT_RETENTION_HOURS=24
WORKER_EXPORT_SWEEP_INTERVAL_MS=3600000

# --- Admin bootstrap (one-time; see production.md "Seed the first super admin") ---------
# SEED_SUPER_ADMIN_EMAIL=ops@codebegun.com
