# ---------------------------------------------------------------------------
# MongoDB + Redis credentials for docker-compose.production.yml.
# Copy to /srv/cbi/.env.datastores (owner root, mode 600). Placeholders only.
# Generate each password with: openssl rand -hex 32   (hex = no URL-encoding needed)
# Read by the mongo, mongo-init and redis containers and by backup.sh.
# ---------------------------------------------------------------------------

# Root user — created by the mongo image on the FIRST start of an empty volume only.
# Changing it later has no effect; see runbook-key-rotation.md.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Application user (readWrite on MONGO_APP_DB). Must match MONGODB_URI in .env.production.
MONGO_APP_DB=cbi_interview
MONGO_APP_USER=cbi_app
MONGO_APP_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Backup user (built-in `backup` role) used by infrastructure/scripts/backup.sh.
MONGO_BACKUP_USER=cbi_backup
MONGO_BACKUP_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# WiredTiger cache (GB). 6 on a 32 GB KVM 8.
MONGO_WT_CACHE_GB=6

# Redis password. Must match REDIS_URL in .env.production.
REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
