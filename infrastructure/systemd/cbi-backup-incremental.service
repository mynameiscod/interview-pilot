# Hourly incremental MongoDB backup: the oplog since the previous run, encrypted and
# uploaded (infrastructure/scripts/backup.sh --mode incremental). Installed by
# provision.sh; enable together with cbi-backup.timer once /srv/cbi/.env.backup is filled in:
#   sudo systemctl enable --now cbi-backup-incremental.timer
#   journalctl -u cbi-backup-incremental.service      # logs
[Unit]
Description=CareerPilot Interview - hourly incremental MongoDB backup (oplog)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Environment=CBI_HOME=/srv/cbi
ExecStart=/bin/bash /srv/cbi/app/infrastructure/scripts/backup.sh --config /srv/cbi/.env.backup --mode incremental
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Waits up to 2 h for a running full backup (shared lock), then runs for minutes.
TimeoutStartSec=3h
PrivateTmp=true
NoNewPrivileges=true
