# Nightly encrypted MongoDB backup (infrastructure/scripts/backup.sh).
# Installed by provision.sh; enable once /srv/cbi/.env.backup is filled in:
#   sudo systemctl enable --now cbi-backup.timer
#   journalctl -u cbi-backup.service      # logs
#   sudo systemctl start cbi-backup.service   # run now
[Unit]
Description=CareerPilot Interview - encrypted MongoDB backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Environment=CBI_HOME=/srv/cbi
ExecStart=/bin/bash /srv/cbi/app/infrastructure/scripts/backup.sh --config /srv/cbi/.env.backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
PrivateTmp=true
NoNewPrivileges=true
